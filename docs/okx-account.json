            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v5/account/positions-history?instType=&instId=&mgnMode=&type=&posId=&after=&before=&limit=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v5", "account", "positions-history"],
          "query": [
            {
              "key": "instType",
              "value": "",
              "description": "产品类型: MARGIN, SWAP, FUTURES, OPTION"
            },
            {
              "key": "instId",
              "value": "",
              "description": "产品ID，如 BTC-USDT-SWAP"
            },
            {
              "key": "mgnMode",
              "value": "",
              "description": "保证金模式: cross, isolated"
            },
            {
              "key": "type",
              "value": "",
              "description": "平仓类型: 1-部分平仓 2-完全平仓 3-强平 4-强减 5-ADL自动减仓"
            },
            {
              "key": "posId",
              "value": "",
              "description": "持仓ID"
            },
            {
              "key": "after",
              "value": "",
              "description": "请求此时间戳之前的数据（毫秒）"
            },
            {
              "key": "before",
              "value": "",
              "description": "请求此时间戳之后的数据（毫秒）"
            },
            {
              "key": "limit",
              "value": "",
              "description": "返回结果的数量，最大为100，默认100"
            }
          ]
        },
        "description": "获取最近3个月有更新的历史仓位信息。\n\n限速：1次/10s\n\n限速规则：UserID"
      },
      "response": []
    },
