{
  "info": {
    "_postman_id": "okx-account-api-v5",
    "name": "OKX Account API",
    "description": "OKX 交易账户 REST API v5\n\n包含账户余额、持仓信息、账单流水、账户配置等接口。\n\n所有接口都需要进行签名认证。\n\n签名方式: HMAC SHA256 + Base64\n\n请求头:\n- OK-ACCESS-KEY: API Key\n- OK-ACCESS-SIGN: 签名 (Base64编码的HMAC SHA256)\n- OK-ACCESS-TIMESTAMP: UTC时间戳 (ISO格式)\n- OK-ACCESS-PASSPHRASE: API密码",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.okx.com",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "secretKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "passphrase",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "查看账户余额",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OK-ACCESS-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "OK-ACCESS-SIGN",
            "value": "{{sign}}",
            "type": "text"
          },
          {
            "key": "OK-ACCESS-TIMESTAMP",
            "value": "{{timestamp}}",
            "type": "text"
          },
          {
            "key": "OK-ACCESS-PASSPHRASE",
            "value": "{{passphrase}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v5/account/balance?ccy=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v5", "account", "balance"],
          "query": [
            {
              "key": "ccy",
              "value": "",
              "description": "币种，如 BTC。支持多币种查询（不超过20个），币种之间半角逗号分隔"
            }
          ]
        },
        "description": "获取交易账户中资金余额信息。\n\n限速：10次/2s\n\n限速规则：UserID"
      },
      "response": []
    },
    {
      "name": "查看持仓信息",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OK-ACCESS-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "OK-ACCESS-SIGN",
            "value": "{{sign}}",
            "type": "text"
          },
          {
            "key": "OK-ACCESS-TIMESTAMP",
            "value": "{{timestamp}}",
            "type": "text"
          },
          {
            "key": "OK-ACCESS-PASSPHRASE",
            "value": "{{passphrase}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v5/account/positions?instType=&instId=&posId=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v5", "account", "positions"],
          "query": [
            {
              "key": "instType",
              "value": "",
              "description": "产品类型: MARGIN, SWAP, FUTURES, OPTION"
            },
            {
              "key": "instId",
              "value": "",
              "description": "产品ID，如 BTC-USDT-SWAP"
            },
            {
              "key": "posId",
              "value": "",
              "description": "持仓ID"
            }
          ]
        },
        "description": "获取该账户下拥有实际持仓的信息。账户为买卖模式会显示net持仓，账户为开平仓模式下会分别返回开多与开空的仓位。\n\n限速：10次/2s\n\n限速规则：UserID"
      },
      "response": []
    },
    {
      "name": "查看历史持仓信息",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OK-ACCESS-KEY",
            "value": "{{apiKey}}",
            "type": "text"
