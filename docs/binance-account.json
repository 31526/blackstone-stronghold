{
  "info": {
    "_postman_id": "binance-account-api-collection",
    "name": "Binance Account API",
    "description": "币安现货账户 REST API 接口集合\n\n## 鉴权说明\n\n所有接口都需要 USER_DATA 权限，需要进行 HMAC SHA256 签名认证。\n\n### 签名步骤\n\n1. 构建查询字符串（包含 timestamp）\n2. 使用 Secret Key 进行 HMAC SHA256 签名\n3. 将签名添加到请求参数中\n4. 在请求头中添加 X-MBX-APIKEY",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.binance.com",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY",
      "type": "string"
    },
    {
      "key": "secretKey",
      "value": "YOUR_SECRET_KEY",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Account Information",
      "item": [
        {
          "name": "Get Account Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-MBX-APIKEY",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v3/account?timestamp={{timestamp}}&signature={{signature}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v3", "account"],
              "query": [
                {
                  "key": "omitZeroBalances",
                  "value": "false",
                  "description": "设为 true 时只返回非零余额",
                  "disabled": true
                },
                {
                  "key": "recvWindow",
                  "value": "5000",
                  "description": "请求有效期（毫秒）",
                  "disabled": true
                },
                {
                  "key": "timestamp",
                  "value": "{{timestamp}}",
                  "description": "时间戳（毫秒）"
                },
                {
                  "key": "signature",
                  "value": "{{signature}}",
                  "description": "HMAC SHA256 签名"
                }
              ]
            },
            "description": "获取当前账户信息\n\n**权重**: 20\n\n**数据源**: Memory => Database"
          }
        },
        {
          "name": "Get Commission Rates",
