{
  "info": {
    "_postman_id": "etherscan-api-collection",
    "name": "Etherscan API",
    "description": "Etherscan API 完整接口集合\n\nBase URL: https://api.etherscan.io/api\n\n使用前请在 Variables 中设置你的 API Key",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.etherscan.io/api",
      "type": "string"
    },
    {
      "key": "apikey",
      "value": "YourApiKeyToken",
      "type": "string"
    },
    {
      "key": "address",
      "value": "0xde0b295669a9fd93d5f28d9ec85e40f4cb697bae",
      "type": "string"
    },
    {
      "key": "contractaddress",
      "value": "0xdac17f958d2ee523a2206206994597c13d831ec7",
      "type": "string"
    },
    {
      "key": "txhash",
      "value": "0x15f8e5ea1079d9a0bb04a4c58ae5fe7654b5b2b4463375ff7ffb490aa0032f3a",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Account (账户)",
      "description": "账户相关接口",
      "item": [
        {
          "name": "1.1 获取单个地址的 ETH 余额",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=balance&address={{address}}&tag=latest&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "balance"},
                {"key": "address", "value": "{{address}}"},
                {"key": "tag", "value": "latest"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取指定地址的原生代币 (ETH) 余额"
          }
        },
        {
          "name": "1.2 获取多个地址的 ETH 余额",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=balancemulti&address={{address}},0xBE0eB53F46cd790Cd13851d5EFf43D12404d33E8&tag=latest&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "balancemulti"},
                {"key": "address", "value": "{{address}},0xBE0eB53F46cd790Cd13851d5EFf43D12404d33E8"},
                {"key": "tag", "value": "latest"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "批量查询多个地址的余额（最多 20 个地址）"
          }
        },
        {
          "name": "1.3 获取普通交易列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=txlist&address={{address}}&startblock=0&endblock=99999999&page=1&offset=10&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "txlist"},
                {"key": "address", "value": "{{address}}"},
                {"key": "startblock", "value": "0"},
                {"key": "endblock", "value": "99999999"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "10"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取地址的普通交易记录"
          }
        },
        {
          "name": "1.4 获取内部交易列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=txlistinternal&address={{address}}&startblock=0&endblock=99999999&page=1&offset=10&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "txlistinternal"},
                {"key": "address", "value": "{{address}}"},
                {"key": "startblock", "value": "0"},
                {"key": "endblock", "value": "99999999"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "10"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取地址的内部交易（合约调用）记录"
          }
        },
        {
          "name": "1.5 根据交易哈希获取内部交易",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=txlistinternal&txhash={{txhash}}&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "txlistinternal"},
                {"key": "txhash", "value": "{{txhash}}"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "根据交易哈希获取内部交易"
          }
        },
        {
          "name": "1.6 获取 ERC20 代币转账记录",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=tokentx&address={{address}}&contractaddress={{contractaddress}}&page=1&offset=100&startblock=0&endblock=99999999&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "tokentx"},
                {"key": "address", "value": "{{address}}"},
                {"key": "contractaddress", "value": "{{contractaddress}}"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "100"},
                {"key": "startblock", "value": "0"},
                {"key": "endblock", "value": "99999999"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取 ERC20 代币转账记录"
          }
        },
        {
          "name": "1.7 获取 ERC721 (NFT) 转账记录",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=tokennfttx&address={{address}}&page=1&offset=100&startblock=0&endblock=99999999&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "tokennfttx"},
                {"key": "address", "value": "{{address}}"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "100"},
                {"key": "startblock", "value": "0"},
                {"key": "endblock", "value": "99999999"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取 ERC721 (NFT) 转账记录"
          }
        },
        {
          "name": "1.8 获取 ERC1155 代币转账记录",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=token1155tx&address={{address}}&page=1&offset=100&startblock=0&endblock=99999999&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "token1155tx"},
                {"key": "address", "value": "{{address}}"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "100"},
                {"key": "startblock", "value": "0"},
                {"key": "endblock", "value": "99999999"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取 ERC1155 代币转账记录"
          }
        },
        {
          "name": "1.9 获取已挖区块列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=getminedblocks&address={{address}}&blocktype=blocks&page=1&offset=10&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "getminedblocks"},
                {"key": "address", "value": "{{address}}"},
                {"key": "blocktype", "value": "blocks"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "10"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取地址作为矿工挖出的区块列表"
          }
        },
        {
          "name": "1.10 获取历史 ETH 余额 (Pro)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=balancehistory&address={{address}}&blockno=8000000&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "balancehistory"},
                {"key": "address", "value": "{{address}}"},
                {"key": "blockno", "value": "8000000"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取指定区块高度时的 ETH 余额（仅限 Pro API）"
          }
        },
        {
          "name": "1.11 获取 ERC20 代币余额",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=tokenbalance&contractaddress={{contractaddress}}&address={{address}}&tag=latest&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "tokenbalance"},
                {"key": "contractaddress", "value": "{{contractaddress}}"},
                {"key": "address", "value": "{{address}}"},
                {"key": "tag", "value": "latest"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取地址的 ERC20 代币余额"
          }
        },
        {
          "name": "1.12 获取地址持有的代币列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=addresstokenbalance&address={{address}}&page=1&offset=100&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "addresstokenbalance"},
                {"key": "address", "value": "{{address}}"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "100"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取地址持有的所有代币列表"
          }
        },
        {
          "name": "1.13 获取地址持有的 NFT 列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=account&action=addresstokennftbalance&address={{address}}&page=1&offset=100&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "account"},
                {"key": "action", "value": "addresstokennftbalance"},
                {"key": "address", "value": "{{address}}"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "100"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取地址持有的所有 NFT 列表"
          }
        }
      ]
    },
    {
      "name": "2. Contract (合约)",
      "description": "智能合约相关接口",
      "item": [
        {
          "name": "2.1 获取已验证合约的 ABI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=contract&action=getabi&address={{contractaddress}}&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "contract"},
                {"key": "action", "value": "getabi"},
                {"key": "address", "value": "{{contractaddress}}"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取已验证合约的 ABI"
          }
        },
        {
          "name": "2.2 获取已验证合约的源代码",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=contract&action=getsourcecode&address={{contractaddress}}&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "contract"},
                {"key": "action", "value": "getsourcecode"},
                {"key": "address", "value": "{{contractaddress}}"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取已验证合约的源代码、编译器版本等信息"
          }
        },
        {
          "name": "2.3 获取合约创建者和创建交易",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=contract&action=getcontractcreation&contractaddresses={{contractaddress}}&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "contract"},
                {"key": "action", "value": "getcontractcreation"},
                {"key": "contractaddresses", "value": "{{contractaddress}}"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取合约创建者地址和创建交易哈希"
          }
        },
        {
          "name": "2.4 检查源代码验证状态",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=contract&action=checkverifystatus&guid=your-guid-here&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "contract"},
                {"key": "action", "value": "checkverifystatus"},
                {"key": "guid", "value": "your-guid-here"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "检查合约源代码验证状态"
          }
        }
      ]
    },
    {
      "name": "3. Transaction (交易)",
      "description": "交易执行状态相关接口",
      "item": [
        {
          "name": "3.1 检查合约执行状态",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=transaction&action=getstatus&txhash={{txhash}}&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "transaction"},
                {"key": "action", "value": "getstatus"},
                {"key": "txhash", "value": "{{txhash}}"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "检查交易执行是否成功（合约交易）"
          }
        },
        {
          "name": "3.2 检查交易收据状态",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=transaction&action=gettxreceiptstatus&txhash={{txhash}}&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "transaction"},
                {"key": "action", "value": "gettxreceiptstatus"},
                {"key": "txhash", "value": "{{txhash}}"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "检查交易是否被成功提交"
          }
        }
      ]
    },
    {
      "name": "4. Block (区块)",
      "description": "区块相关接口",
      "item": [
        {
          "name": "4.1 获取区块奖励",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=block&action=getblockreward&blockno=2165403&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "block"},
                {"key": "action", "value": "getblockreward"},
                {"key": "blockno", "value": "2165403"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取矿工的区块奖励和叔块奖励"
          }
        },
        {
          "name": "4.2 获取区块倒计时",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=block&action=getblockcountdown&blockno=20000000&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "block"},
                {"key": "action", "value": "getblockcountdown"},
                {"key": "blockno", "value": "20000000"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "估算到达指定区块号的剩余时间"
          }
        },
        {
          "name": "4.3 根据时间戳获取区块号",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=block&action=getblocknobytime&timestamp=1578638524&closest=before&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "block"},
                {"key": "action", "value": "getblocknobytime"},
                {"key": "timestamp", "value": "1578638524"},
                {"key": "closest", "value": "before"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "根据 Unix 时间戳获取最接近的区块号"
          }
        },
        {
          "name": "4.4 获取每日平均区块大小 (Pro)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=block&action=dailyavgblocksize&startdate=2019-02-01&enddate=2019-02-28&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "block"},
                {"key": "action", "value": "dailyavgblocksize"},
                {"key": "startdate", "value": "2019-02-01"},
                {"key": "enddate", "value": "2019-02-28"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取每日平均区块大小"
          }
        },
        {
          "name": "4.5 获取每日区块数量和奖励 (Pro)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=block&action=dailyblkcount&startdate=2019-02-01&enddate=2019-02-28&sort=asc&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "block"},
                {"key": "action", "value": "dailyblkcount"},
                {"key": "startdate", "value": "2019-02-01"},
                {"key": "enddate", "value": "2019-02-28"},
                {"key": "sort", "value": "asc"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取每日区块数量和奖励"
          }
        }
      ]
    },
    {
      "name": "5. Logs (日志)",
      "description": "事件日志查询接口",
      "item": [
        {
          "name": "5.1 获取事件日志（按地址）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=logs&action=getLogs&address={{contractaddress}}&fromBlock=0&toBlock=latest&page=1&offset=1000&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "logs"},
                {"key": "action", "value": "getLogs"},
                {"key": "address", "value": "{{contractaddress}}"},
                {"key": "fromBlock", "value": "0"},
                {"key": "toBlock", "value": "latest"},
                {"key": "page", "value": "1"},
                {"key": "offset", "value": "1000"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "根据地址获取事件日志"
          }
        },
        {
          "name": "5.2 获取事件日志（按主题过滤）",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=logs&action=getLogs&address={{contractaddress}}&fromBlock=0&toBlock=latest&topic0=0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "logs"},
                {"key": "action", "value": "getLogs"},
                {"key": "address", "value": "{{contractaddress}}"},
                {"key": "fromBlock", "value": "0"},
                {"key": "toBlock", "value": "latest"},
                {"key": "topic0", "value": "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "根据主题过滤获取事件日志 (topic0 是 Transfer 事件签名)"
          }
        }
      ]
    },
    {
      "name": "6. Geth/Parity Proxy (代理)",
      "description": "以太坊 JSON-RPC API 代理接口",
      "item": [
        {
          "name": "6.1 eth_blockNumber",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=proxy&action=eth_blockNumber&apikey={{apikey}}",
              "host": ["{{baseUrl}}"],
              "query": [
                {"key": "module", "value": "proxy"},
                {"key": "action", "value": "eth_blockNumber"},
                {"key": "apikey", "value": "{{apikey}}"}
              ]
            },
            "description": "获取最新区块号"
          }
        },
        {
          "name": "6.2 eth_getBlockByNumber",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?module=proxy&action=eth_getBlockByNumber&tag=0x10d4f&boolean=true&apikey={{apikey}}",
