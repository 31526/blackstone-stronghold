    {
      "name": "Trading - 交易接口",
      "item": [
        {
          "name": "New Order - 下单",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MBX-APIKEY",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v3/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v3", "order"],
              "query": [
                {
                  "key": "symbol",
                  "value": "BTCUSDT",
                  "description": "交易对"
                },
                {
                  "key": "side",
                  "value": "BUY",
                  "description": "BUY或SELL"
                },
                {
                  "key": "type",
                  "value": "LIMIT",
                  "description": "订单类型"
                },
                {
                  "key": "timeInForce",
                  "value": "GTC",
                  "description": "有效期: GTC/IOC/FOK"
                },
                {
                  "key": "quantity",
                  "value": "0.001",
                  "description": "数量"
                },
                {
                  "key": "price",
                  "value": "40000",
                  "description": "价格"
                },
                {
                  "key": "timestamp",
                  "value": "{{$timestamp}}000",
                  "description": "时间戳"
                },
                {
                  "key": "signature",
                  "value": "",
                  "description": "签名"
                }
              ]
            },
            "description": "下单\n\n权重: 1\n鉴权: TRADE"
          }
        },
        {
          "name": "Test Order - 测试下单",
