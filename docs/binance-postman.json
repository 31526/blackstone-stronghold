{
  "info": {
    "_postman_id": "binance-spot-api-collection",
    "name": "Binance Spot REST API",
    "description": "币安现货交易REST API接口集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.binance.com",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "secretKey",
      "value": "",
