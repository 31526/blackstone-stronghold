  "item": [
    {
      "name": "General - 通用接口",
      "item": [
        {
          "name": "Ping - 测试连通性",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v3/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v3", "ping"]
            },
            "description": "测试REST API的连通性\n\n权重: 1\n鉴权: NONE"
          }
        },
        {
          "name": "Time - 服务器时间",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v3/time",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v3", "time"]
            },
            "description": "获取服务器时间\n\n权重: 1\n鉴权: NONE"
          }
        },
        {
          "name": "Exchange Info - 交易所信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v3/exchangeInfo",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v3", "exchangeInfo"],
              "query": [
                {
                  "key": "symbol",
                  "value": "BTCUSDT",
                  "disabled": true
                },
                {
                  "key": "symbols",
                  "value": "[\"BTCUSDT\",\"BNBUSDT\"]",
                  "disabled": true
                }
              ]
            },
            "description": "获取交易所交易规则和交易对信息\n\n权重: 20\n鉴权: NONE"
          }
        }
      ]
