      "item": [
        {
          "name": "Depth - 深度信息",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v3/depth?symbol=BTCUSDT&limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v3", "depth"],
              "query": [
                {
                  "key": "symbol",
                  "value": "BTCUSDT",
                  "description": "交易对"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "默认100, 最大5000. 可选: 5, 10, 20, 50, 100, 500, 1000, 5000"
                }
              ]
            },
            "description": "获取交易对深度信息\n\n权重: 根据limit变化 (5-50: 5, 100: 10, 500: 25, 1000: 50, 5000: 250)\n鉴权: NONE"
          }
        },
